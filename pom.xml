<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.bhu</groupId>
    <artifactId>runshi-studio-web</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>runshi-studio-web</name>
    <description>runshi-studio-web</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!--
            LangChain4j 版本：langchain4j 与 langchain4j-open-ai 必须同版本，故抽成属性避免漂移。
            （langchain4j-open-ai 的 POM 里把 langchain4j-reactive-streaming 钉在 beta 版上，
              升级时留意传递依赖的版本变化。）
        -->
        <langchain4j.version>1.20.2</langchain4j.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MyBatis-Plus SpringBoot4 Starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- MyBatis-Plus 插件模块：3.5.9 起插件改为可选依赖，PaginationInnerInterceptor 在此模块中 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Lettuce 连接池依赖：spring.data.redis.lettuce.pool.* 的配置只有在 classpath 上存在
            commons-pool2 时才会生效，缺了它连接池参数会被静默忽略（不会报错，但也不生效）。
            版本由 spring-boot-dependencies 统一管理，无需手写。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Validation 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Knife4j Next（社区维护 fork，唯一支持 Spring Boot 4 的版本线） -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
            <version>5.7.5</version>
        </dependency>

        <!--
            Hutool 加密模块：BCrypt（sys_user.user_password 的加密方案）、MD5/SHA、AES、
            SM2/SM3/SM4 等都在这里。

            为什么引 hutool-crypto 而不是全量 hutool-all：
            - hutool-crypto 会自动带上 hutool-core，加密场景够用，不会把 Excel / PDF / HTTP
              等用不到的模块一起打进包（体积与依赖冲突面都更小）；
            - 二者不要同时引入，会造成重复类与版本冲突。若后续图省事要换全量，
              只把 artifactId 改成 hutool-all 即可，坐标与版本号完全一致。

            版本必须手写：Hutool 不在 spring-boot-dependencies 的版本管理范围内，
            不写版本号会直接报 'dependencies.dependency.version' is missing。
        -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
            <version>5.8.47</version>
        </dependency>

        <!--
            Sa-Token 认证框架：Spring Boot 4 专用 starter（1.45.0 起正式支持 Boot 4）。

            为什么不引 sa-token-spring-boot-starter（那个是 Boot 2/3 用的）：
            Boot 4 内置 Jackson 3，序列化包名从 com.fasterxml.jackson 变成 tools.jackson。
            本 starter 内部依赖的是 sa-token-spring-boot-webmvc-v3v4-common + sa-token-jackson3，
            即已经适配 Jackson 3；引旧 starter 会在运行期抛 NoClassDefFoundError。

            版本号必须手写：Sa-Token 不在 spring-boot-dependencies 的版本管理范围内。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!--
            Sa-Token 会话持久化到 Redis：登录态、权限、Session 等数据从内存搬到 Redis，
            服务重启/多实例部署时登录状态不丢失，也不再依赖单机内存。

            为什么是 sa-token-redis-template，而不是 sa-token-redis-jackson：
            sa-token-spring-boot4-starter 已经带了 sa-token-jackson3（Jackson 3 版序列化）。
            若再引 sa-token-redis-jackson，会额外引入它的 Jackson 2 版模块 sa-token-jackson，
            导致「同功能的两个序列化模块并存」，可能让 Sa-Token 的 JSON 模板装配产生歧义。
            （补充事实：本项目 classpath 上本来就有 Jackson 2 —— 由 knife4j 的 swagger-core-jakarta
             传递引入 jackson-databind 2.21.5，所以问题不是"有没有 Jackson 2"，而是"不要重复引入同功能模块"。）

            sa-token-redis-template 只依赖 sa-token-core + spring-boot-starter-data-redis（本项目已有），
            内部注册 SaTokenDaoForRedisTemplate，用 StringRedisTemplate 以 JSON 字符串存储会话数据，
            序列化交给 starter 自带的 sa-token-jackson3（Jackson 3），因此与 Boot 4 完全兼容。

            注意：它会自动从容器中的 RedisConnectionFactory 取连接，
            连的是 application-dev.yml 里 spring.data.redis 配置的那个实例，不需要额外配置。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!--
            ===== AI 咨询=====

            LangChain4j：AI 应用的统一抽象层（ChatModel / ChatMemory / AiServices / RAG /
            EmbeddingStore / Tools / MCP ...）。这里刻意引「主 artifact + OpenAI 集成」两个模块，
            而不是只用裸 HTTP 手写协议，理由是**后续要扩展**：
              - 需要流式输出        → 换 OpenAiStreamingChatModel，业务层不用动；
              - 需要多轮记忆        → ChatMemory / MessageWindowChatMemory；
              - 需要声明式接口      → @AiService 注解 + AiServices.builder()（接口即 AI 服务）；
              - 需要 RAG            → DocumentSplitter / EmbeddingStore / ContentRetriever；
              - 需要工具调用/联网    → @Tool + ToolSpecification；
              - 需要换模型（通义/智谱等）→ 只换 open-ai 这一层依赖，上层 ChatModel 不动。
            这些都是自写 HTTP 客户端做不到的「改一层就够」的位置。

            为什么不用 langchain4j-spring-boot-starter / langchain4j-open-ai-spring-boot-starter：
              - 它们面向 Boot 3，本项目是 Boot 4（Jackson 3 在 tools.jackson 下，
                Boot 3 starter 的自动配置在 Boot 4 上可能直接报错或静默失效）；
              - 本项目自己装配 Bean（见 config/AiProperties + manager/AiManager），
                只用 `studio.ai.*` 一份配置，不依赖 starter 的 application.properties 键名约定。

            它的传递依赖会带 Jackson 2（2.22.x）+ opennlp-tools + jtokkit：
              Jackson 2 本项目 classpath 本来就有（knife4j → swagger-core-jakarta → jackson-databind），
              只是版本会被抬到 2.22.x；opennlp 是文档切分（RAG）需要的，属预期内。
              注意：这些是 com.fasterxml 的 Jackson 2，与 Boot 4 的 Jackson 3（tools.jackson）
              互不干扰——本项目自己的序列化仍然全部走 Jackson 3。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                测试期把上传根目录指向 target 下，而不是真实上传目录（D:/runshi-studio-upload）。

                为什么用系统属性而不是在每个测试类上写 @SpringBootTest(properties = "...")：
                写法上的差别会带来**多个 Spring 容器**——每个不同的 properties 都会新建并缓存一个上下文，
                而 Sa-Token 的 SaManager 是静态持有者，跨容器时它会指向另一个上下文里的 Redis 连接工厂，
                表现为「LettuceConnectionFactory has been STOPPED」这类与代码无关的随机失败。
                统一用一个上下文后，测试更快也更稳定。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <FILE_ROOT_DIR>${project.build.directory}/test-uploads</FILE_ROOT_DIR>
                        <!-- 测试环境默认关闭游客 IP 限流。
                             既有匿名提问用例极多，而 MockMvc 下所有请求的来源 IP 都是 127.0.0.1，
                             一旦默认开启，跑到第 6 个用例就会集体 42900——那是假失败，会掩盖真实问题。
                             限流专项测试类用 @DynamicPropertySource 覆盖为 true（优先级高于系统属性）。 -->
                        <studio.ai.guest-ip-limits-enabled>false</studio.ai.guest-ip-limits-enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
