<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.bhu</groupId>
    <artifactId>runshi-studio-web</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>runshi-studio-web</name>
    <description>runshi-studio-web</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MyBatis-Plus SpringBoot4 Starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- MyBatis-Plus 插件模块：3.5.9 起插件改为可选依赖，PaginationInnerInterceptor 在此模块中 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Lettuce 连接池依赖：spring.data.redis.lettuce.pool.* 的配置只有在 classpath 上存在
            commons-pool2 时才会生效，缺了它连接池参数会被静默忽略（不会报错，但也不生效）。
            版本由 spring-boot-dependencies 统一管理，无需手写。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Validation 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Knife4j Next（社区维护 fork，唯一支持 Spring Boot 4 的版本线） -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
            <version>5.7.5</version>
        </dependency>

        <!--
            Hutool 加密模块：BCrypt（sys_user.user_password 的加密方案）、MD5/SHA、AES、
            SM2/SM3/SM4 等都在这里。

            为什么引 hutool-crypto 而不是全量 hutool-all：
            - hutool-crypto 会自动带上 hutool-core，加密场景够用，不会把 Excel / PDF / HTTP
              等用不到的模块一起打进包（体积与依赖冲突面都更小）；
            - 二者不要同时引入，会造成重复类与版本冲突。若后续图省事要换全量，
              只把 artifactId 改成 hutool-all 即可，坐标与版本号完全一致。

            版本必须手写：Hutool 不在 spring-boot-dependencies 的版本管理范围内，
            不写版本号会直接报 'dependencies.dependency.version' is missing。
        -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
            <version>5.8.47</version>
        </dependency>

        <!--
            Sa-Token 认证框架：Spring Boot 4 专用 starter（1.45.0 起正式支持 Boot 4）。

            为什么不引 sa-token-spring-boot-starter（那个是 Boot 2/3 用的）：
            Boot 4 内置 Jackson 3，序列化包名从 com.fasterxml.jackson 变成 tools.jackson。
            本 starter 内部依赖的是 sa-token-spring-boot-webmvc-v3v4-common + sa-token-jackson3，
            即已经适配 Jackson 3；引旧 starter 会在运行期抛 NoClassDefFoundError。

            版本号必须手写：Sa-Token 不在 spring-boot-dependencies 的版本管理范围内。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!--
            Sa-Token 会话持久化到 Redis：登录态、权限、Session 等数据从内存搬到 Redis，
            服务重启/多实例部署时登录状态不丢失，也不再依赖单机内存。

            为什么是 sa-token-redis-template，而不是 sa-token-redis-jackson：
            sa-token-spring-boot4-starter 已经带了 sa-token-jackson3（Jackson 3 版序列化）。
            若再引 sa-token-redis-jackson，会额外引入它的 Jackson 2 版模块 sa-token-jackson，
            导致「同功能的两个序列化模块并存」，可能让 Sa-Token 的 JSON 模板装配产生歧义。
            （补充事实：本项目 classpath 上本来就有 Jackson 2 —— 由 knife4j 的 swagger-core-jakarta
             传递引入 jackson-databind 2.21.5，所以问题不是"有没有 Jackson 2"，而是"不要重复引入同功能模块"。）

            sa-token-redis-template 只依赖 sa-token-core + spring-boot-starter-data-redis（本项目已有），
            内部注册 SaTokenDaoForRedisTemplate，用 StringRedisTemplate 以 JSON 字符串存储会话数据，
            序列化交给 starter 自带的 sa-token-jackson3（Jackson 3），因此与 Boot 4 完全兼容。

            注意：它会自动从容器中的 RedisConnectionFactory 取连接，
            连的是 application-dev.yml 里 spring.data.redis 配置的那个实例，不需要额外配置。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
            <version>1.46.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                测试期把上传根目录指向 target 下，而不是真实上传目录（D:/runshi-studio-upload）。

                为什么用系统属性而不是在每个测试类上写 @SpringBootTest(properties = "...")：
                写法上的差别会带来**多个 Spring 容器**——每个不同的 properties 都会新建并缓存一个上下文，
                而 Sa-Token 的 SaManager 是静态持有者，跨容器时它会指向另一个上下文里的 Redis 连接工厂，
                表现为「LettuceConnectionFactory has been STOPPED」这类与代码无关的随机失败。
                统一用一个上下文后，测试更快也更稳定。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <FILE_ROOT_DIR>${project.build.directory}/test-uploads</FILE_ROOT_DIR>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
